# Supabase Dashboard > Connect > Session pooler에서 값을 확인하세요.
# URL은 postgresql:// 대신 jdbc:postgresql:// 로 시작해야 합니다.
SPRING_PROFILES_ACTIVE=supabase
SUPABASE_DB_URL=jdbc:postgresql://aws-0-REGION.pooler.supabase.com:5432/postgres?sslmode=require
SUPABASE_DB_USERNAME=postgres.PROJECT_REF
SUPABASE_DB_PASSWORD=YOUR_DATABASE_PASSWORD

# 소규모 데모 환경의 기본 연결 풀 설정
DB_MAX_POOL_SIZE=5
DB_MIN_IDLE=1
# Supabase migrations own the schema. Hibernate must never mutate it.
JPA_DDL_AUTO=validate
# ERD3 application schema.
JPA_DEFAULT_SCHEMA=public

# AI defaults to mock so local development and CI do not require an external call.
FITLY_AI_PROVIDER=mock
FITLY_VISION_PROVIDER=mock
FITLY_AI_MODEL=gpt-4o-mini
FITLY_AI_TEMPERATURE=0.2
FITLY_AI_MAX_CANDIDATES=5
# Set only when FITLY_AI_PROVIDER=openai.
OPENAI_API_KEY=
