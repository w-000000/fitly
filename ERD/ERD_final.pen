                      "name": "XOR Note Title",
                      "fill": "#93370D",
                      "content": "CORE CONSTRAINT  ·  SOURCE TYPE / FK CONSISTENCY",
                      "fontFamily": "Inter",
                      "fontSize": 14,
                      "fontWeight": "700"
                    },
                    {
                      "type": "text",
                      "id": "y99jK",
                      "name": "XOR Note Body",
                      "fill": "#7A2E0E",
                      "textGrowth": "fixed-width",
                      "width": 564,
                      "content": "CHECK (\n (source_type = 'WARDROBE'\n  AND wardrobe_item_id IS NOT NULL\n  AND product_variant_id IS NULL\n  AND price_snapshot IS NULL)\n OR\n (source_type = 'RENTAL_PRODUCT'\n  AND wardrobe_item_id IS NULL\n  AND product_variant_id IS NOT NULL\n  AND price_snapshot IS NOT NULL)\n)\nsource_type determines exactly one source FK and price snapshot",
                      "lineHeight": 1.32,
                      "fontFamily": "IBM Plex Mono",
                      "fontSize": 10,
                      "fontWeight": "normal"
                    }
                  ]
                },
