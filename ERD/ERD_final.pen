                  "width": 600,
                  "height": 310,
                  "fill": "#FFFAEB",
                  "cornerRadius": 8,
                  "stroke": "#F79009",
                  "strokeWidth": 1,
                  "layout": "vertical",
                  "gap": 10,
                  "padding": 18,
                  "children": [
                    {
                      "type": "text",
