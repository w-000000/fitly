                  "y": 650,
                  "name": "ERD Legend",
                  "width": 720,
                  "height": 850,
                  "fill": "$paper",
                  "cornerRadius": 10,
                  "stroke": "#98A2B3",
                  "strokeWidth": 1,
                  "layout": "vertical",
                  "gap": 12,
                  "padding": 24,
                  "children": [
                    {
                      "type": "text",
                      "id": "LUo7w",
                      "name": "Legend Title",
                      "fill": "$ink",
                      "content": "LEGEND",
                      "fontFamily": "Inter",
                      "fontSize": 20,
                      "fontWeight": "700"
                    },
                    {
                      "type": "rectangle",
                      "id": "XbiEN",
                      "name": "Legend Rule",
                      "fill": "#EAECF0",
                      "width": "fill_container",
                      "height": 1
                    },
                    {
                      "type": "text",
                      "id": "zVO3Q",
                      "name": "Legend Keys",
                      "fill": "$ink",
                      "textGrowth": "fixed-width",
                      "width": "fill_container",
                      "content": "PK Primary Key · FK Foreign Key · UK Unique · CK Check\nBR Business Rule · NN NOT NULL · NULL Nullable · DF Default\n\n|     Exactly One\nO|    Zero or One\nO<    Zero or Many\n|<    One or Many\n\n|──O|   1 : 0..1  (no crow’s foot)\n|──O<   1 : 0..N  (crow’s foot only on N side)\nNotation: PARENT 1 : cardinality CHILD",
                      "lineHeight": 1.35,
                      "fontFamily": "IBM Plex Mono",
                      "fontSize": 9.5,
                      "fontWeight": "normal"
                    },
                    {
                      "type": "text",
                      "id": "jdqUU",
                      "name": "Legend Domains Heading",
                      "fill": "$ink",
                      "content": "DOMAIN COLORS",
                      "fontFamily": "Inter",
                      "fontSize": 14,
                      "fontWeight": "700"
                    },
                    {
                      "type": "text",
                      "id": "k50At",
                      "name": "Domain Color Legend",
                      "fill": "$ink",
                      "textGrowth": "fixed-width",
                      "width": "fill_container",
                      "content": "■  USER / AUTH                light blue\n■  CUSTOMER / AI              light purple\n■  BUSINESS / PRODUCT         light green\n■  RENTAL / RETURN            light orange\n■  SETTLEMENT                 light gray",
                      "lineHeight": 1.8,
                      "fontFamily": "IBM Plex Mono",
                      "fontSize": 12,
                      "fontWeight": "normal"
                    },
                    {
                      "type": "text",
                      "id": "Pjc5g",
                      "name": "Business Rules Heading",
                      "fill": "$ink",
                      "content": "BUSINESS RULES · SERVICE LAYER",
                      "fontFamily": "Inter",
                      "fontSize": 13,
                      "fontWeight": "700"
                    },
                    {
                      "type": "text",
                      "id": "E2DOY",
                      "name": "Business Rules Body",
                      "fill": "$ink",
                      "textGrowth": "fixed-width",
                      "width": "fill_container",
                      "content": "BR  Request user = referenced wardrobe owner\nBR  Rental user = source recommendation request user\nBR  Generation/creator BUSINESS must match BUSINESS_MEMBER/PRODUCT\nBR  BUSINESS_MEMBER.user_id must have ENTERPRISE role\nBR  GROUP ↔ GROUP_RENTAL_DETAIL existence\nBR  GROUP_RENTAL_REQUEST_ITEM only for GROUP order\nBR  COMPLETED request → completed_at NOT NULL\nBR  SETTLED settlement → settled_at NOT NULL\nBR  inventory_restored TRUE → restored_at NOT NULL\nBR  Return transitions: request → return → inspect → laundry → restore\nBR  processed_by_admin USER must have ADMIN role\nBR  Stock changes in same rental/return transaction\nBR  One ACTIVE contract per BUSINESS; history allowed\nBR  CATEGORY_DOMAIN = {TOP | BOTTOM | OUTER | SHOES | ACCESSORY}\nBR  Link tables may consider CASCADE; history tables prefer RESTRICT/soft delete\nBR  Frequently queried FK columns need indexes in physical schema\nBR  SKU uniqueness policy defined at implementation time",
                      "lineHeight": 1.25,
                      "fontFamily": "IBM Plex Mono",
                      "fontSize": 8,
                      "fontWeight": "normal"
                    }
                  ]
                },
                {
                  "type": "text",
                  "id": "bdDfn",
                  "x": 40,
                  "y": 580,
                  "name": "Settlement Principle",
                  "fill": "$muted",
                  "content": "Actual supplying BUSINESS receives the settlement · contract history remains explicit",
                  "fontFamily": "Inter",
                  "fontSize": 13,
                  "fontWeight": "600"
                },
