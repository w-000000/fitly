                      "content": "PK  return_process_id BIGINT NOT NULL\nUK·FK  rental_item_id BIGINT NOT NULL → RENTAL_ITEM.rental_item_id\nFK  processed_by_admin_user_id BIGINT NULL → USER.user_id\n    return_status VARCHAR(20) NOT NULL\nCK  {REQUESTED | RETURNED | COMPLETED}\n    inspection_status VARCHAR(20) NOT NULL\nCK  {PENDING | INSPECTING | COMPLETED}\n    inspection_grade VARCHAR(20) NULL\nCK  {NORMAL | MINOR_STAIN | DAMAGED}\n    laundry_status VARCHAR(20) NOT NULL\nCK  {PENDING | CLEANING | COMPLETED}\n    inventory_restored BOOLEAN NOT NULL DEFAULT FALSE\n    return_requested_at TIMESTAMPTZ NOT NULL\n    returned_at TIMESTAMPTZ NULL\n    inspected_at TIMESTAMPTZ NULL\n    cleaned_at TIMESTAMPTZ NULL\n    inventory_restored_at TIMESTAMPTZ NULL\n    created_at TIMESTAMPTZ NOT NULL DEFAULT now()\n    updated_at TIMESTAMPTZ NOT NULL",
