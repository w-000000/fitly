                      "x": 18,
                      "y": 62,
                      "name": "BUSINESS_SETTLEMENT Columns",
                      "fill": "$ink",
                      "textGrowth": "fixed-width",
                      "width": 684,
                      "content": "PK  settlement_id BIGINT NOT NULL\nFK  contract_id BIGINT NOT NULL → BUSINESS_CONTRACT.contract_id\n    period_start DATE NOT NULL\n    period_end DATE NOT NULL\nCK  period_start <= period_end\n    rental_gross_amount BIGINT NOT NULL\nCK  rental_gross_amount >= 0\n    rent_to_own_gross_amount BIGINT NOT NULL\nCK  rent_to_own_gross_amount >= 0\n    commission_amount BIGINT NOT NULL\nCK  commission_amount >= 0\n    settlement_amount BIGINT NOT NULL\nCK  settlement_amount >= 0\n    status VARCHAR(20) NOT NULL CK {PENDING | SETTLED | FAILED}\n    settled_at TIMESTAMPTZ NULL\n    created_at TIMESTAMPTZ NOT NULL DEFAULT now()\nUK  UNIQUE(contract_id, period_start, period_end)",
                      "lineHeight": 1.28,
                      "fontFamily": "IBM Plex Mono",
                      "fontSize": 7.8,
                      "fontWeight": "normal"
                    }
                  ]
                },
                {
                  "type": "frame",
                  "id": "V5z44X",
