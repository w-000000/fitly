          "fontFamily": "Inter",
          "fontSize": 11,
          "fontWeight": "700"
        },
        {
          "type": "text",
          "id": "M6Ci5",
          "x": 927,
          "y": 680.9565710101508,
          "name": "Dockerfile Label",
          "rotation": 0.18834220065706997,
          "fill": "#526174",
          "textGrowth": "fixed-width-height",
          "width": 263,
          "height": 86,
          "content": "- 공용 DB → 팀원 5명이 동일한 데이터·스키마 공유 \n- 배포 연동 → Render에서 외부 DB로 바로 접근\n- 관리 용이 → 로컬 DB 외부 공개·서버 관리 불필요 \n\n→ 짧은 개발 기간에 협업·배포 환경을 빠르게 구성",
          "fontFamily": "Inter",
          "fontSize": 11,
          "fontWeight": "normal"
        },
